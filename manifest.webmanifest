{
  "id": "./",
  "name": "Shell Savings \u2014 Daily Challenge",
  "short_name": "Shell Savings",
  "description": "A cute daily savings tracker. Set your own goal and days, then colour a shell each time you save.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fff9fc",
  "theme_color": "#fff5f8",
